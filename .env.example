# Optional AI summary. Leave empty to use the deterministic rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Warehouse and runtime policy.
INSIGHTFLOW_DB_PATH=data/warehouse/insightflow.db
# Optional shared code that holds the whole app behind one prompt.
# INSIGHTFLOW_ACCESS_CODE=
# Refuse a watched file if any row breaks the contract, instead of setting those rows aside.
# INSIGHTFLOW_STRICT_IMPORT=false
INSIGHTFLOW_READ_ONLY=false
INSIGHTFLOW_APP_ENV=local
INSIGHTFLOW_CACHE_TTL_SECONDS=300
INSIGHTFLOW_ROOT_DIR=.
INSIGHTFLOW_SERVER_ADDRESS=127.0.0.1
INSIGHTFLOW_SERVER_PORT=8501

# Reporting currency for new warehouses, and the share of returned stock that can be resold.
INSIGHTFLOW_CURRENCY=GBP
INSIGHTFLOW_RETURN_RECOVERY_RATE=1.0
